generator client {
  provider = "prisma-client-js" 
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"

 
}

model Organization {
  id          String    @id @default(uuid())
  name        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]
  problems    Problem[]
}

// --- 1. COMPETITIONS TABLE ---
model Competition {
  id                        String   @id @default(uuid())
  title                     String
  startTime                 DateTime
  endTime                   DateTime
  fullScreenMandatory       Boolean  @default(false)
  keyboardShortcutsBlocked   Boolean  @default(false)

  problems                  CompetitionProblem[]
  participants              CompetitionParticipant[]
  submissions               Submission[]
}

// --- 1. USERS TABLE ---
model User {
  id             String        @id @default(uuid())
  email          String        @unique
  username       String        @unique
  role           Role          @default(USER)
  organizationId String?

  // Flattened authentication fields
  password       String?  // Make optional for Google login users
  salt           String?  // Make optional for Google login users
  googleId       String?   @unique // Add this for Google OAuth
  sessionToken   String? 
  refreshToken   String? 

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt 

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  submissions    Submission[]
  participations  CompetitionParticipant[]
}

// --- 2. PROBLEMS TABLE (Normalized Core) ---
model Problem {
  id               String            @id // e.g., "two-sum"
  title            String
  description      String            @db.Text
  difficulty       Difficulty        @default(EASY)
  organizationId   String?
  
  // Separated Test Cases
  publicTestCases  Json         
  privateTestCases Json         
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  organization     Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions      Submission[] 
  languageConfigs  ProblemLanguage[] // NEW: Links to the language configs!
  competitionLinks CompetitionProblem[]
  
  parameterTypes   String[]            // e.g., ["array", "integer"]           
  questionTypes   String[]            // e.g., ["algorithm", "data structure"]
  @@index([title])
  @@index([organizationId])
}

// --- 3. COMPETITION PROBLEM LINKS ---
model CompetitionProblem {
  id             String      @id @default(uuid())
  competitionId  String
  problemId      String

  competition    Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  problem        Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([competitionId, problemId])
}

// --- 4. COMPETITION PARTICIPANTS ---
model CompetitionParticipant {
  id               String      @id @default(uuid())
  competitionId    String
  userId           String
  cheatingAttempts Int         @default(0)
  score            Int         @default(0)

  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
}

// --- 5. PROBLEM LANGUAGE CONFIGS (The BCNF Fix) ---
model ProblemLanguage {
  id              String   @id @default(uuid())
  problemId       String
  language        String   // e.g., "cpp", "python"
  
  starterCode     String   @db.Text
  driverCode      String   @db.Text
  timeLimitMs     Int      
  memoryLimitMb   Int      

  problem         Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  // A problem can only have ONE config per language
  @@unique([problemId, language]) 
}

// --- 6. SUBMISSIONS TABLE (The Ledger) ---
model Submission {
  id                String   @id @default(uuid())
  userId            String
  problemId         String
  competitionId     String?
  language          String
  code              String   @db.Text
  status            String   
  
  // Granular Grading Results
  errorMessage      String?  @db.Text 
  executionTimeMs   Int?     
  memoryUsedKb      Int?     
  testCasesPassed   Int?     
  totalTestCases    Int?     
  
  createdAt         DateTime @default(now())

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem           Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  competition       Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  @@index([userId, problemId, language, createdAt(sort: Desc)])
  @@index([competitionId])
}

// --- 7. ENUMS ---
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Role {
  USER
  ADMIN
}